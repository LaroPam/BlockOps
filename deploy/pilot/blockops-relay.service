[Unit]
Description=BlockOps relay service (pilot)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blockops
Group=blockops
ExecStart=/opt/blockops/blockops-relay --listen /ip4/0.0.0.0/tcp/4001 --external /ip4/REPLACE_WITH_PUBLIC_IPV4/tcp/4001 --identity-file /var/lib/blockops/identity.key --max-circuit-bytes 67108864 --max-circuit-seconds 3600
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blockops
UMask=0077
MemoryMax=512M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
