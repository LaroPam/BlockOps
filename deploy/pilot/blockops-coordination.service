[Unit]
Description=BlockOps coordination service (pilot)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blockops
Group=blockops
ExecStart=/opt/blockops/blockops-coordination serve --bind 127.0.0.1:8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=256M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
